{
  "name": "playai-local",
  "main": "src/provider/cloudflare.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomObject"
      },
      {
        "name": "LIMITS",
        "class_name": "AdmissionLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomObject",
        "AdmissionLimiter"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
